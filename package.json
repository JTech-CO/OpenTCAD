{
  "name": "opentcad",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual open-source semiconductor process and device simulation workspace",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @opentcad/web",
    "build": "npm run build --workspace @opentcad/web",
    "preview": "npm run preview --workspace @opentcad/web",
    "lint": "npm run lint --workspace @opentcad/web",
    "observe:base001": "node tools/observe-reference-run.mjs",
    "prepare:base001-image": "node tools/prepare-reference-image-build.mjs",
    "test:validation": "node --test validation/baseline/observation.test.mjs validation/baseline/reference-image-build.test.mjs validation/comparators/comparators.test.mjs validation/faults/supervisor.test.mjs",
    "test": "npm run test:validation && npm run test --workspace @opentcad/web",
    "coverage": "npm run coverage --workspace @opentcad/web",
    "check:planning": "node tools/check-planning-bundle.mjs",
    "check:m0": "node tools/check-m0.mjs",
    "check:m1": "node tools/check-m1.mjs",
    "check:ko-copy": "node tools/check-korean-punctuation.mjs",
    "check": "npm run check:planning && npm run check:m0 && npm run check:m1 && npm run check:ko-copy && npm run lint && npm run test && npm run build"
  }
}
