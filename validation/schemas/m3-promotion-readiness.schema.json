{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentcad.invalid/schemas/m3-promotion-readiness.schema.json",
  "title": "OpenTCAD M3 promotion readiness record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "revision",
    "manifest",
    "imageLock",
    "approval",
    "gates",
    "runtimeQualifications"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": { "const": "m3-promotion-readiness" },
    "revision": { "$ref": "#/$defs/revision" },
    "manifest": { "$ref": "#/$defs/hashReference" },
    "imageLock": { "$ref": "#/$defs/hashReference" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "approvedBy", "approvedAt"],
      "properties": {
        "approvalId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "approvedBy": { "$ref": "#/$defs/reviewer" },
        "approvedAt": { "$ref": "#/$defs/approvalTime" }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/gate" }
    },
    "runtimeQualifications": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/runtimeQualification" }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approvalTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "hashReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "revisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "revision"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "approved", "approvedBy", "approvedAt", "evidence"],
      "properties": {
        "id": {
          "enum": [
            "runtime-adapters",
            "native-fencing",
            "local-transport",
            "lifecycle-integration",
            "credentials-and-scheduler",
            "power-loss",
            "platform-qualification",
            "solver-release"
          ]
        },
        "approved": { "const": true },
        "approvedBy": { "$ref": "#/$defs/reviewer" },
        "approvedAt": { "$ref": "#/$defs/approvalTime" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/revisionEvidence" }
        }
      }
    },
    "runtimeQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "backend", "evidence"],
      "properties": {
        "platform": { "enum": ["windows", "macos", "linux"] },
        "backend": { "enum": ["docker", "podman"] },
        "evidence": { "$ref": "#/$defs/revisionEvidence" }
      }
    }
  }
}
