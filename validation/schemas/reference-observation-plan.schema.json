{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opentcad:schema:reference-observation-plan:1",
  "title": "OpenTCAD external reference observation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "milestone",
    "observationId",
    "caseId",
    "classification",
    "baselinePromotionAllowed",
    "reference",
    "requiredProfile",
    "image",
    "invocation",
    "logPolicy",
    "inputs",
    "artifacts",
    "metrics"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "milestone": { "const": "M0" },
    "observationId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "classification": { "const": "non-baseline-portability-observation" },
    "baselinePromotionAllowed": { "const": false },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "requiredProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "operatingSystem", "architecture", "rootless"],
      "properties": {
        "runtime": { "enum": ["docker", "podman"] },
        "operatingSystem": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "rootless": { "type": "boolean" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "distribution"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "distribution": { "type": "string", "minLength": 1 }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args", "stdinInputId", "timeoutMs", "repeats", "environmentAllowlist"],
      "properties": {
        "args": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "stdinInputId": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "repeats": { "type": "integer", "minimum": 1, "maximum": 10 },
        "environmentAllowlist": { "type": "array", "items": { "type": "string" } }
      }
    },
    "logPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "failurePatterns"],
      "properties": {
        "mode": { "const": "fail-on-match" },
        "failurePatterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "stream", "substring"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "stream": { "enum": ["stdout", "stderr", "both"] },
              "substring": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileDescriptor" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/fileDescriptor" },
          {
            "type": "object",
            "required": ["required"],
            "properties": { "required": { "type": "boolean" } }
          }
        ]
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "artifactId", "prefixes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "const": "line-prefix-counts" },
          "artifactId": { "type": "string", "minLength": 1 },
          "prefixes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "relativePath"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "relativePath": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    }
  }
}
